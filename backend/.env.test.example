# Banco EXCLUSIVO para os testes — ele é apagado por `npm run db:test:reset`.
# Suba um local com: podman run -d --name chiquinho-test-db -e POSTGRES_PASSWORD=postgres \
#   -e POSTGRES_DB=chiquinho_test -p 55432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/chiquinho_test"
JWT_SECRET="segredo-de-teste"
