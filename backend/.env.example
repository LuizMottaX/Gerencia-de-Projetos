# Conexão com o PostgreSQL (Coolify ou local via Docker).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Se o servidor não tiver TLS, adicione ?sslmode=disable no final.
DATABASE_URL="postgresql://postgres:senha@localhost:5432/postgres"

# Porta da API (opcional — padrão 3001).
PORT=3001

# Segredo para assinar os tokens do painel admin (obrigatório).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Admin criado pelo seed (`npm run db:seed`). Sem ADMIN_SENHA o seed não cria admin.
ADMIN_EMAIL="admin@chiquinhomotors.com.br"
ADMIN_SENHA=""
