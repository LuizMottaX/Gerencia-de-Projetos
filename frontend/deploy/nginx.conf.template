# Processado pelo entrypoint do nginx: ${BACKEND_URL} vem do ambiente.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # API e fotos do painel ficam no backend.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 6m; # uploads de até 5 MB
  }
  location /uploads/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
  }

  # Arquivos com hash no nome nunca mudam: cache longo.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location /fonts/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA: qualquer outra rota cai no index.html (o Vue Router resolve).
  location / {
    try_files $uri $uri/ /index.html;
  }
}
